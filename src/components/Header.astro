---
import { t, otherLocale, homePath, workPath } from '../i18n/ui';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  slug?: string;
}

const { locale, slug } = Astro.props;
const strings = t(locale);
const other = otherLocale(locale);
const altHref = slug ? workPath(other, slug) : homePath(other);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={homePath(locale)} class="site-header__brand" aria-label="Juan Miguel Galarza Seidlitz — home">
      <img src="/logo_jmg.png" alt="JMG" width="36" height="36" />
      <span class="mono site-header__name">Juan Miguel Galarza Seidlitz</span>
    </a>

    <nav class="site-header__controls" aria-label="Site">
      <a class="site-header__link mono" href="#footer-cv">{strings.nav_cv}</a>
      <a class="site-header__lang mono" href={altHref} aria-label={strings.lang_toggle}>
        {locale === 'en' ? 'ES' : 'EN'}
      </a>
      <button type="button" class="site-header__theme" data-theme-toggle aria-label={strings.theme_toggle}>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.6" />
          <path
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"
          />
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linejoin="round"
            d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z"
          />
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    transition: background-color var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    text-decoration: none;
    color: var(--fg);
  }

  .site-header__brand img {
    border-radius: var(--radius);
  }

  .site-header__name {
    font-size: var(--text-sm);
    display: none;
  }

  @media (min-width: 768px) {
    .site-header__name {
      display: inline;
    }
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-header__link {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--fg);
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .site-header__link:hover {
    border-color: var(--accent);
  }

  .site-header__lang {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--bg);
    background: var(--accent);
    padding: 0.35rem 0.6rem;
    border-radius: var(--radius);
    line-height: 1;
    transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
  }

  .site-header__lang:hover {
    opacity: 0.85;
  }

  .site-header__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg);
    transition: border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .site-header__theme:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .icon-moon {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-moon {
    display: block;
  }
</style>
